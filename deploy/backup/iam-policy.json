{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheBackupPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET",
      "Condition": {"StringLike": {"s3:prefix": ["recet/*"]}}
    },
    {
      "Sid": "WriteAndReadBackups",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::BUCKET/recet/*"
    }
  ]
}
